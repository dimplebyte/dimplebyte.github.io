<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description" content="Premium marble collection by Dimple Khangarot. Explore luxury marble, tiles and natural stone for homes, hotels and commercial spaces.">

    <title>Dimple Marble | Premium Marble & Natural Stone</title>

    <link rel="stylesheet" href="style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>

<!-- ================= NAVBAR ================= -->

<header class="navbar">

    <div class="logo">
        <span class="logo-mark">DK</span>

        <div>
            <h2>DIMPLE</h2>
            <span>MARBLE & STONE</span>
        </div>
    </div>

    <nav id="navMenu">

        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#collection">Collection</a>
        <a href="#gallery">Gallery</a>
        <a href="#contact">Contact</a>

    </nav>

    <div class="nav-actions">

        <button class="cart-btn" onclick="openCart()">
            <i class="fa-solid fa-bag-shopping"></i>
            <span id="cartCount">0</span>
        </button>

        <button class="menu-btn" onclick="toggleMenu()">
            <i class="fa-solid fa-bars"></i>
        </button>

    </div>

</header>


<!-- ================= HERO ================= -->

<section class="hero" id="home">

    <div class="hero-overlay"></div>

    <div class="hero-content">

        <p class="eyebrow">TIMELESS • NATURAL • ELEGANT</p>

        <h1>
            The Art of
            <span>Natural Marble</span>
        </h1>

        <p class="hero-text">
            Discover premium marble and natural stone crafted by nature
            and selected for extraordinary spaces.
        </p>

        <div class="hero-buttons">

            <a href="#collection" class="btn primary-btn">
                Explore Collection
                <i class="fa-solid fa-arrow-right"></i>
            </a>

            <a href="#contact" class="btn outline-btn">
                Get a Quote
            </a>

        </div>

    </div>

    <div class="hero-scroll">
        <span>SCROLL TO EXPLORE</span>
        <i class="fa-solid fa-chevron-down"></i>
    </div>

</section>


<!-- ================= TRUST BAR ================= -->

<section class="trust-bar">

    <div class="trust-item">
        <i class="fa-solid fa-gem"></i>
        <div>
            <strong>Premium Quality</strong>
            <span>Selected natural stone</span>
        </div>
    </div>

    <div class="trust-item">
        <i class="fa-solid fa-truck-fast"></i>
        <div>
            <strong>Safe Delivery</strong>
            <span>Careful handling & transport</span>
        </div>
    </div>

    <div class="trust-item">
        <i class="fa-solid fa-handshake"></i>
        <div>
            <strong>Direct Enquiry</strong>
            <span>Personalized assistance</span>
        </div>
    </div>

    <div class="trust-item">
        <i class="fa-solid fa-star"></i>
        <div>
            <strong>Trusted Selection</strong>
            <span>Quality you can see</span>
        </div>
    </div>

</section>


<!-- ================= ABOUT ================= -->

<section class="about section" id="about">

    <div class="about-image">

        <img
            src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1000&q=85"
            alt="Luxury marble interior"
        >

        <div class="experience-card">
            <strong>01</strong>
            <span>Premium<br>Marble</span>
        </div>

    </div>

    <div class="about-content">

        <p class="section-label">ABOUT DIMPLE MARBLE</p>

        <h2>
            Beauty carved
            <span>by nature.</span>
        </h2>

        <p>
            At Dimple Marble & Stone, we believe that marble is more than
            just a building material. Every slab has its own personality,
            pattern and character.
        </p>

        <p>
            Founded and managed by <strong>Dimple Khangarot</strong>,
            our aim is to help homeowners, architects, designers and
            businesses discover beautiful natural stone for extraordinary
            spaces.
        </p>

        <div class="about-features">

            <div>
                <i class="fa-solid fa-check"></i>
                Carefully selected stone
            </div>

            <div>
                <i class="fa-solid fa-check"></i>
                Premium finish
            </div>

            <div>
                <i class="fa-solid fa-check"></i>
                Custom requirements
            </div>

            <div>
                <i class="fa-solid fa-check"></i>
                Professional assistance
            </div>

        </div>

        <a href="#contact" class="text-link">
            Talk to Dimple
            <i class="fa-solid fa-arrow-right"></i>
        </a>

    </div>

</section>


<!-- ================= COLLECTION ================= -->

<section class="collection section" id="collection">

    <div class="section-heading">

        <div>
            <p class="section-label">OUR COLLECTION</p>

            <h2>
                Find your
                <span>perfect stone.</span>
            </h2>
        </div>

        <p>
            Explore our selection of premium natural marble and stone.
            Select a product to enquire about availability and pricing.
        </p>

    </div>


    <!-- SEARCH -->

    <div class="catalog-tools">

        <div class="search-box">

            <i class="fa-solid fa-magnifying-glass"></i>

            <input
                type="text"
                id="searchInput"
                placeholder="Search marble..."
                onkeyup="filterProducts()"
            >

        </div>

        <div class="filters">

            <button class="filter active" onclick="setCategory('all', this)">
                All
            </button>

            <button class="filter" onclick="setCategory('white', this)">
                White
            </button>

            <button class="filter" onclick="setCategory('dark', this)">
                Dark
            </button>

            <button class="filter" onclick="setCategory('luxury', this)">
                Luxury
            </button>

            <button class="filter" onclick="setCategory('stone', this)">
                Natural Stone
            </button>

        </div>

    </div>


    <!-- PRODUCTS -->

    <div class="products-grid" id="productsGrid">

        <!-- PRODUCT 1 -->

        <article class="product-card"
                 data-category="white"
                 data-name="Carrara White Marble">

            <div class="product-image">

                <img
                    src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=900&q=85"
                    alt="Carrara White Marble"
                >

                <span class="product-tag">POPULAR</span>

                <button class="quick-btn"
                        onclick="quickView('Carrara White Marble')">
                    <i class="fa-regular fa-eye"></i>
                </button>

            </div>

            <div class="product-info">

                <span class="product-type">WHITE MARBLE</span>

                <h3>Carrara White</h3>

                <p>
                    Elegant white marble with subtle natural veining.
                </p>

                <div class="product-bottom">

                    <span class="price">Enquire</span>

                    <button onclick="addToCart('Carrara White Marble')">
                        <i class="fa-solid fa-plus"></i>
                        Add
                    </button>

                </div>

            </div>

        </article>


        <!-- PRODUCT 2 -->

        <article class="product-card"
                 data-category="luxury"
                 data-name="Calacatta Gold Marble">

            <div class="product-image">

                <img
                    src="https://images.unsplash.com/photo-1615529162924-f8605388461d?auto=format&fit=crop&w=900&q=85"
                    alt="Calacatta Gold Marble"
                >

                <span class="product-tag luxury-tag">LUXURY</span>

                <button class="quick-btn"
                        onclick="quickView('Calacatta Gold Marble')">
                    <i class="fa-regular fa-eye"></i>
                </button>

            </div>

            <div class="product-info">

                <span class="product-type">LUXURY MARBLE</span>

                <h3>Calacatta Gold</h3>

                <p>
                    Dramatic white marble with elegant golden veins.
                </p>

                <div class="product-bottom">

                    <span class="price">Enquire</span>

                    <button onclick="addToCart('Calacatta Gold Marble')">
                        <i class="fa-solid fa-plus"></i>
                        Add
                    </button>

                </div>

            </div>

        </article>


        <!-- PRODUCT 3 -->

        <article class="product-card"
                 data-category="dark"
                 data-name="Black Marquina Marble">

            <div class="product-image">

                <img
                    src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=900&q=85"
                    alt="Black Marble"
                >

                <span class="product-tag dark-tag">DARK</span>

                <button class="quick-btn"
                        onclick="quickView('Black Marquina Marble')">
                    <i class="fa-regular fa-eye"></i>
                </button>

            </div>

            <div class="product-info">

                <span class="product-type">DARK MARBLE</span>

                <h3>Black Marquina</h3>

                <p>
                    Deep black stone with striking natural white veins.
                </p>

                <div class="product-bottom">

                    <span class="price">Enquire</span>

                    <button onclick="addToCart('Black Marquina Marble')">
                        <i class="fa-solid fa-plus"></i>
                        Add
                    </button>

                </div>

            </div>

        </article>


        <!-- PRODUCT 4 -->

        <article class="product-card"
                 data-category="white"
                 data-name="Makarana White Marble">

            <div class="product-image">

                <img
                    src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=900&q=85"
                    alt="White Marble"
                >

                <span class="product-tag">INDIAN</span>

                <button class="quick-btn"
                        onclick="quickView('Makarana White Marble')">
                    <i class="fa-regular fa-eye"></i>
                </button>

            </div>

            <div class="product-info">

                <span class="product-type">INDIAN MARBLE</span>

                <h3>Makarana White</h3>

                <p>
                    Classic Indian marble known for its clean appearance.
                </p>

                <div class="product-bottom">

                    <span class="price">Enquire</span>

                    <button onclick="addToCart('Makarana White Marble')">
                        <i class="fa-solid fa-plus"></i>
                        Add
                    </button>

                </div>

            </div>

        </article>


        <!-- PRODUCT 5 -->

        <article class="product-card"
                 data-category="luxury"
                 data-name="Onyx Premium Stone">

            <div class="product-image">

                <img
                    src="https://images.unsplash.com/photo-1615874694520-474822394e73?auto=format&fit=crop&w=900&q=85"
                    alt="Luxury Onyx Stone"
                >

                <span class="product-tag luxury-tag">PREMIUM</span>

                <button class="quick-btn"
                        onclick="quickView('Onyx Premium Stone')">
                    <i class="fa-regular fa-eye"></i>
                </button>

            </div>

            <div class="product-info">

                <span class="product-type">ONYX</span>

                <h3>Premium Onyx</h3>

                <p>
                    Translucent natural stone for statement interiors.
                </p>

                <div class="product-bottom">

                    <span class="price">Enquire</span>

                    <button onclick="addToCart('Onyx Premium Stone')">
                        <i class="fa-solid fa-plus"></i>
                        Add
                    </button>

                </div>

            </div>

        </article>


        <!-- PRODUCT 6 -->

        <article class="product-card"
                 data-category="stone"
                 data-name="Natural Travertine">

            <div class="product-image">

                <img
                    src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=900&q=85"
                    alt="Travertine Natural Stone"
                >

                <span class="product-tag stone-tag">NATURAL</span>

                <button class="quick-btn"
                        onclick="quickView('Natural Travertine')">
                    <i class="fa-regular fa-eye"></i>
                </button>

            </div>

            <div class="product-info">

                <span class="product-type">NATURAL STONE</span>

                <h3>Travertine</h3>

                <p>
                    Warm natural stone perfect for modern architecture.
                </p>

                <div class="product-bottom">

                    <span class="price">Enquire</span>

                    <button onclick="addToCart('Natural Travertine')">
                        <i class="fa-solid fa-plus"></i>
                        Add
                    </button>

                </div>

            </div>

        </article>

    </div>

</section>


<!-- ================= WHY US ================= -->

<section class="why-us">

    <div class="why-content">

        <p class="section-label">WHY CHOOSE US</p>

        <h2>
            Marble that makes
            <span>a statement.</span>
        </h2>

        <p>
            From a single home project to large commercial requirements,
            we help you choose the right natural stone for your space.
        </p>

        <a href="#contact" class="btn primary-btn">
            Start Your Project
        </a>

    </div>


    <div class="why-stats">

        <div>
            <strong>100%</strong>
            <span>Natural Stone Selection</span>
        </div>

        <div>
            <strong>01</strong>
            <span>Personalized Assistance</span>
        </div>

        <div>
            <strong>∞</strong>
            <span>Design Possibilities</span>
        </div>

    </div>

</section>


<!-- ================= GALLERY ================= -->

<section class="gallery section" id="gallery">

    <div class="section-heading">

        <div>

            <p class="section-label">MARBLE INSPIRATION</p>

            <h2>
                Designed for
                <span>beautiful spaces.</span>
            </h2>

        </div>

    </div>


    <div class="gallery-grid">

        <div class="gallery-item large">

            <img
                src="https://images.unsplash.com/photo-1600607688969-a5bfcd646154?auto=format&fit=crop&w=1200&q=85"
                alt="Luxury marble interior"
            >

            <div class="gallery-overlay">
                <span>Luxury Interiors</span>
            </div>

        </div>


        <div class="gallery-item">

            <img
                src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=900&q=85"
                alt="Marble interior"
            >

            <div class="gallery-overlay">
                <span>Modern Homes</span>
            </div>

        </div>


        <div class="gallery-item">

            <img
                src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=900&q=85"
                alt="Luxury home"
            >

            <div class="gallery-overlay">
                <span>Architectural Spaces</span>
            </div>

        </div>


        <div class="gallery-item">

            <img
                src="https://images.unsplash.com/photo-1600210491892-03d54c0aaf87?auto=format&fit=crop&w=900&q=85"
                alt="Stone interior"
            >

            <div class="gallery-overlay">
                <span>Premium Finish</span>
            </div>

        </div>

    </div>

</section>


<!-- ================= CONTACT ================= -->

<section class="contact section" id="contact">

    <div class="contact-info">

        <p class="section-label">GET IN TOUCH</p>

        <h2>
            Let's find the
            <span>right marble.</span>
        </h2>

        <p>
            Tell us what you are looking for and Dimple will get back
            to you regarding availability, pricing and requirements.
        </p>

        <div class="contact-details">

            <div class="contact-detail">

                <div class="contact-icon">
                    <i class="fa-solid fa-user"></i>
                </div>

                <div>
                    <span>OWNER</span>
                    <strong>Dimple Khangarot</strong>
                </div>

            </div>


            <div class="contact-detail">

                <div class="contact-icon">
                    <i class="fa-solid fa-phone"></i>
                </div>

                <div>
                    <span>PHONE</span>
                    <strong>+91 XXXXX XXXXX</strong>
                </div>

            </div>


            <div class="contact-detail">

                <div class="contact-icon">
                    <i class="fa-solid fa-envelope"></i>
                </div>

                <div>
                    <span>EMAIL</span>
                    <strong>your@email.com</strong>
                </div>

            </div>

        </div>

    </div>


    <form class="contact-form" onsubmit="sendEnquiry(event)">

        <h3>Request a Quote</h3>

        <p>
            Fill in your details and we'll contact you.
        </p>

        <div class="form-row">

            <div class="input-group">

                <label>Your Name</label>

                <input
                    type="text"
                    id="name"
                    placeholder="Enter your name"
                    required
                >

            </div>

            <div class="input-group">

                <label>Phone Number</label>

                <input
                    type="tel"
                    id="phone"
                    placeholder="+91"
                    required
                >

            </div>

        </div>


        <div class="input-group">

            <label>What are you looking for?</label>

            <select id="marbleType">

                <option value="">Select marble type</option>

                <option>White Marble</option>
                <option>Luxury Marble</option>
                <option>Dark Marble</option>
                <option>Natural Stone</option>
                <option>Other</option>

            </select>

        </div>


        <div class="input-group">

            <label>Message</label>

            <textarea
                id="message"
                rows="4"
                placeholder="Tell us about your requirement..."
            ></textarea>

        </div>


        <button class="btn primary-btn form-btn" type="submit">

            Send Enquiry
            <i class="fa-solid fa-arrow-right"></i>

        </button>

    </form>

</section>


<!-- ================= FOOTER ================= -->

<footer>

    <div class="footer-main">

        <div class="footer-brand">

            <div class="logo">

                <span class="logo-mark">DK</span>

                <div>
                    <h2>DIMPLE</h2>
                    <span>MARBLE & STONE</span>
                </div>

            </div>

            <p>
                Premium marble and natural stone for spaces
                that deserve something extraordinary.
            </p>

            <div class="social-icons">

                <a href="#" aria-label="Instagram">
                    <i class="fa-brands fa-instagram"></i>
                </a>

                <a href="#" aria-label="Facebook">
                    <i class="fa-brands fa-facebook-f"></i>
                </a>

                <a href="#" aria-label="WhatsApp">
                    <i class="fa-brands fa-whatsapp"></i>
                </a>

            </div>

        </div>


        <div class="footer-column">

            <h4>Explore</h4>

            <a href="#home">Home</a>
            <a href="#about">About Us</a>
            <a href="#collection">Collection</a>
            <a href="#gallery">Gallery</a>

        </div>


        <div class="footer-column">

            <h4>Collection</h4>

            <a href="#collection">White Marble</a>
            <a href="#collection">Luxury Marble</a>
            <a href="#collection">Dark Marble</a>
            <a href="#collection">Natural Stone</a>

        </div>


        <div class="footer-column">

            <h4>Contact</h4>

            <span>Dimple Khangarot</span>
            <span>India</span>
            <span>+91 XXXXX XXXXX</span>
            <span>your@email.com</span>

        </div>

    </div>


    <div class="footer-bottom">

        <span>
            © 2026 Dimple Marble & Stone. All Rights Reserved.
        </span>

        <span>
            Owned by <strong>Dimple Khangarot</strong>
        </span>

    </div>

</footer>


<!-- ================= CART ================= -->

<div class="cart-overlay" id="cartOverlay" onclick="closeCart()"></div>

<aside class="cart" id="cart">

    <div class="cart-header">

        <h3>Your Enquiry</h3>

        <button onclick="closeCart()">
            <i class="fa-solid fa-xmark"></i>
        </button>

    </div>


    <div class="cart-items" id="cartItems">

        <div class="empty-cart">

            <i class="fa-regular fa-gem"></i>

            <h4>Your selection is empty</h4>

            <p>Add marble products you'd like to enquire about.</p>

        </div>

    </div>


    <div class="cart-footer">

        <p>
            Products selected:
            <strong id="cartTotal">0</strong>
        </p>

        <button class="btn primary-btn"
                onclick="sendWhatsAppEnquiry()">

            Enquire on WhatsApp
            <i class="fa-brands fa-whatsapp"></i>

        </button>

    </div>

</aside>


<!-- ================= QUICK VIEW MODAL ================= -->

<div class="modal" id="quickModal">

    <div class="modal-box">

        <button class="modal-close" onclick="closeModal()">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <div id="modalContent"></div>

    </div>

</div>


<script src="script.js"></script>

</body>
</html>
